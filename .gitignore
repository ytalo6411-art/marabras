# ── Dependências ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build ────────────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ── Segredos e ambiente ─────────────────────────────────────────────────────
# NUNCA commite .env — este é o erro que vazou credenciais no projeto anterior.
.env
.env.*
!.env.example
.vercel
*.pem

# ── Banco de dados local ────────────────────────────────────────────────────
# SQLite não é usado como persistência de produção, mas não deve ir ao Git.
data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Supabase CLI ─────────────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/config.toml.local

# ── Testes e coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Caches de ferramentas ────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── SO / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ── Screenshots de teste (PWA / E2E) ────────────────────────────────────────
test-results/
playwright-report/
blob-report/
.playwright/

# TypeScript incremental build info
*.tsbuildinfo

# Código-fonte de dados da aplicação (não são datasets locais):
# taxonomia de exercícios, modelos de treino e catálogo de emergência.
# Sem esta exceção, o build quebra em um clone limpo.
!/src/data/
!/src/data/**
