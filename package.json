{
  "name": "athletix",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "ATHLETIX — plataforma profissional de treinamento físico, nutrição e evolução esportiva",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "postinstall": "node scripts/verify-env.mjs --warn-only",
    "seed:exercises": "node scripts/seed-exercises.mjs",
    "seed:foods": "node scripts/seed-foods.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "typecheck:api": "tsc --noEmit --strict --moduleResolution bundler --module esnext --target es2022 --skipLibCheck --types node api/ai/*.ts api/_lib/*.ts",
    "db:check": "node scripts/apply-migrations.mjs --check",
    "db:apply": "node scripts/apply-migrations.mjs",
    "db:selftest": "node scripts/apply-migrations.mjs --self-test",
    "test:db": "node scripts/test-database.mjs",
    "test:browser": "playwright test",
    "test:i18n": "node scripts/extract-i18n.mjs && node scripts/check-i18n.mjs",
    "browser:prepare": "node scripts/prepare-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
