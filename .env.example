# ─────────────────────────────────────────────────────────────
# ATHLETIX — variáveis de ambiente
# Copie este arquivo para `.env` (ou `.env.local`) e preencha.
# NUNCA commite o arquivo `.env` real — ele está no .gitignore.
# ─────────────────────────────────────────────────────────────

# ── SUPABASE (obrigatório) ───────────────────────────────────
# Onde encontrar:
#   Supabase Dashboard → seu projeto → Project Settings → API
#
# A URL e a chave "anon public" são SEGURAS para o frontend.
# Elas são protegidas pelas políticas RLS (Row Level Security).
# A chave "service_role" NÃO deve nunca ir aqui — ela é secreta
# e só pode ser usada em ambiente server-side.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── APP ─────────────────────────────────────────────────────
# URL pública do app (usada nos callbacks OAuth e no PWA).
# Em produção: https://athletix.com.br
# Em desenvolvimento: http://localhost:5173
VITE_APP_URL=http://localhost:5173

# ── APIS EXTERNAS (todas opcionais — a app tem fallback) ────

# Open Food Facts — produtos industrializados, código de barras.
# Sem cadastro. Licença: ODbL.
VITE_OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org

# USDA FoodData Central — composição nutricional oficial.
# Sem frontend key. Requer chave apenas para uso massivo (API key).
# Plano gratuito: 1000 req/h com key, 30 req/h sem key.
VITE_USDA_BASE_URL=https://api.nal.usda.gov/fdc

# wger — exercícios e base alimentar abertos.
# Sem cadastro para leitura. Licença: AGPLv3 (dados).
VITE_WGER_BASE_URL=https://wger.de/api/v2

# Free Exercise DB — exercícios demonstrativos com vídeo.
# MIT / free-to-use. Vídeos e thumbnails servidos pelo CDN deles.
VITE_FREEEXERCISEDB_BASE_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main

# Leitor de código de barras via câmera.
# Endpoint opcional que recebe a imagem e devolve o código.
# Deixe vazio para usar o fallback: digitação manual do código.
VITE_BARCODE_DETECTOR_BASE_URL=

# ── SUPABASE — SERVIDOR (somente em ambiente server-side) ───
# NÃO prefixe com VITE_ — Vite expõe tudo com VITE_ ao navegador.
# Use apenas em functions server-side / CI.
# SUPABASE_SERVICE_ROLE_KEY=
